.q-bottom{display:flex;justify-content:space-between;gap:8px;margin-top:20px}
.q-end-actions{display:flex;justify-content:flex-end;margin-top:15px;padding-top:14px;border-top:1px solid var(--border)}
.result-panel{margin-bottom:18px;border-left:4px solid var(--violet)}
.result-panel h2{font-size:25px;margin:7px 0}
.result-percent{display:grid;place-items:center;min-width:83px;min-height:83px;padding:12px;border-radius:17px;background:var(--violet-light);color:var(--violet);font-size:25px;font-weight:850}
.plus-summary-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:8px 0 15px}
.plus-summary-stats>div{background:var(--surface2);padding:15px;border-radius:12px}
.plus-summary-stats small{display:block;color:var(--muted);font-size:11px}
.plus-summary-stats strong{font-size:24px;display:block;margin-top:7px}
.plus-mini-bars{display:flex;align-items:flex-end;gap:8px;min-height:115px;margin-top:10px}
.plus-mini-bar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:115px;min-width:0}
.plus-mini-bar div{background:linear-gradient(180deg,#665eee,#37c3bb);border-radius:8px 8px 0 0;min-height:3px}
.plus-mini-bar small{font-size:9px;text-align:center;color:var(--muted);margin-top:5px}
.lesson-filter{display:flex;align-items:center;gap:12px;margin-bottom:13px}
.lesson-filter select{max-width:300px}
.lesson-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.lesson-card{text-align:left;padding:18px;cursor:pointer;background:var(--surface);border:1px solid var(--border);min-height:160px;display:flex;flex-direction:column;gap:9px}
.lesson-card:hover,.library-card:hover{border-color:var(--violet)}
.lesson-card h3{font-size:16px;line-height:1.4}
.lesson-card p{color:var(--muted);font-size:12px;line-height:1.55;flex:1}
.lesson-card .flex-row b{font-size:11px;color:var(--violet)}
.lesson-detail h2{margin:8px 0 13px;font-size:24px}
.lesson-detail h3{margin-top:20px;margin-bottom:8px;font-size:14px}
.lesson-detail ul{padding-left:20px;line-height:1.8;font-size:13px}
.lesson-detail p{font-size:13px;line-height:1.7}
.lesson-checkbox{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:750}
.library-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:16px 0}
.library-card{border:1px solid var(--border);border-radius:13px;background:var(--surface2);color:var(--text);padding:15px;text-align:left;display:flex;flex-direction:column;gap:8px;cursor:pointer}
.library-card strong{font-size:13px}
.library-card small{font-size:11px;color:var(--muted);line-height:1.5}
.library-icon{font-size:28px;color:var(--violet)}
.library-upload{display:flex;flex-wrap:wrap;align-items:center;gap:11px;margin-top:13px}
.library-upload small{flex:1 1 100%}
.study-doc-viewer{width:100%;height:72vh;border:1px solid var(--border);border-radius:9px;background:white;margin-top:13px}
.leg-links{display:grid;gap:8px;margin-top:15px}
.leg-links a{color:var(--text);display:flex;align-items:center;gap:12px;text-decoration:none;border:1px solid var(--border);border-radius:11px;padding:13px}
.leg-links a:hover{border-color:var(--violet)}
.leg-links strong{flex:1;font-size:13px}
.leg-links small{color:var(--muted);font-size:11px;flex:1}
.leg-links span{color:var(--violet)}
@media(max-width:1160px){.q-layout{grid-template-columns:1fr}.q-book{position:static}.q-page-scroll{max-height:70vh}.q-layout.native-only{max-width:none}}
@media(max-width:650px){.q-layout{gap:10px}.q-interactive{padding:12px}.q-number-grid{grid-template-columns:repeat(8,1fr)}.q-page-scroll{max-height:62vh}.q-page-scroll img{min-width:610px}.lesson-grid,.library-grid{grid-template-columns:1fr}.plus-summary-stats{gap:6px}.plus-summary-stats>div{padding:11px}.plus-summary-stats strong{font-size:20px}.q-body h2{font-size:15px}.leg-links a{flex-wrap:wrap}.leg-links small{flex:1 1 100%;order:3}.result-panel h2{font-size:20px}.result-percent{min-width:65px;min-height:65px;font-size:20px}.lesson-detail h2{font-size:20px}}


/* v2.1 - Navegação recolhível, leitor sem rolagem horizontal e PDFs em tela cheia. */
html,body{max-width:100%;overflow-x:clip}
.main-area,.main-content,.q-layout,.q-book,.q-interactive{min-width:0}
.main-area{width:0} /* flex:1 determina a largura; não estende o documento */
.topbar{position:sticky;top:0;z-index:17;box-shadow:0 2px 8px rgba(12,23,48,.035)}
body.bank-page .topbar{position:static;box-shadow:none}
.sidebar{transition:width .18s ease,min-width .18s ease,padding .18s ease}
.sidebar-compact-btn{flex-shrink:0;font-size:11px}
.nav-item .nav-label{font-size:inherit;white-space:normal}
body.sidebar-compact .sidebar{width:76px;min-width:76px;padding-inline:9px}
body.sidebar-compact .sidebar .brand{justify-content:center;padding:0 0 26px}
body.sidebar-compact .brand>div:last-child,
body.sidebar-compact .sidebar .side-heading,
body.sidebar-compact .sidebar .nav-label,
body.sidebar-compact .sidebar .sidebar-bottom{display:none}
body.sidebar-compact .sidebar .nav-item{justify-content:center;padding:12px 8px;gap:0}
body.sidebar-compact .sidebar .nav-item>span:first-child{width:auto;font-size:22px}
body.sidebar-compact .sidebar-compact-btn{background:var(--violet-light);color:var(--violet)}

/* Cada folha fica inteiramente ajustada à área disponível, sem recorte nem scroll interno. */
.q-layout.with-pages{grid-template-columns:minmax(0,1.13fr) minmax(0,1fr);align-items:start}
.q-book{position:sticky;top:12px;display:flex;flex-direction:column;overflow:hidden;min-width:0;max-height:calc(100dvh - 24px)}
.q-page-toolbar{flex-shrink:0;flex-wrap:wrap;min-width:0}
.q-page-toolbar strong{flex:1;min-width:135px}
.q-page-toolbar>div{align-items:center;flex-wrap:wrap}
.q-page-scroll{overflow:hidden!important;min-height:0;height:calc(100dvh - 145px);max-height:800px;display:flex;justify-content:center;align-items:center;padding:8px;background:#edf1f7}
.q-page-scroll img,.q-page-scroll img#qExamPage{display:block;object-fit:contain;object-position:center;min-width:0!important;max-width:100%!important;max-height:100%!important;width:100%!important;height:100%!important;margin:auto}
.q-book-help{flex-shrink:0}
.q-interactive{min-width:0;overflow-wrap:anywhere}
.q-number-grid{grid-template-columns:repeat(8,minmax(0,1fr))}
.q-book .btn,.pdf-doc-shell .btn{min-height:36px}

/* Alternância entre tela cheia real e tela cheia de compatibilidade com iOS/PWA. */
.q-book:fullscreen,.q-book.eo-fullscreen,.pdf-doc-shell:fullscreen,.pdf-doc-shell.eo-fullscreen{
 position:fixed!important;inset:0!important;top:0!important;left:0!important;
 width:100vw!important;height:100dvh!important;max-height:none!important;max-width:none!important;
 border-radius:0!important;margin:0!important;z-index:200!important;
 background:var(--surface);display:flex;flex-direction:column;overflow:hidden
}
.q-book:fullscreen .q-page-scroll,.q-book.eo-fullscreen .q-page-scroll{
 flex:1 1 auto;height:auto!important;max-height:none!important;min-height:0;padding:10px
}
.q-book:fullscreen .q-page-scroll img,.q-book.eo-fullscreen .q-page-scroll img{max-height:100%!important;max-width:100%!important}
.pdf-doc-shell:fullscreen .study-doc-viewer,.pdf-doc-shell.eo-fullscreen .study-doc-viewer{
 flex:1 1 auto;width:100%;height:100%;min-height:0;border:0;border-radius:0;margin:0
}
.pdf-doc-shell:fullscreen .flex-row,.pdf-doc-shell.eo-fullscreen .flex-row{flex-shrink:0;padding:8px 12px}
body.eo-viewer-lock{overflow:hidden!important}
.study-doc-viewer{display:block;max-width:100%}

@media(min-width:951px){
 .q-layout.with-pages .q-book{align-self:start}
}
@media(max-width:1150px){
 .q-layout.with-pages{grid-template-columns:minmax(0,1fr)}
 .q-book{position:sticky;top:0;z-index:10;max-height:min(54dvh,440px)}
 .q-page-scroll{height:calc(min(54dvh,440px) - 88px);max-height:none;padding:5px}
 .q-book-help{display:none}
 .q-layout{gap:12px}
}
@media(max-width:950px){
 .sidebar-compact-btn{display:none!important}
 body.sidebar-compact .sidebar{width:260px;min-width:260px;padding-inline:16px}
 body.sidebar-compact .sidebar .brand{justify-content:initial;padding:0 12px 35px}
 body.sidebar-compact .sidebar .brand>div:last-child,
 body.sidebar-compact .sidebar .side-heading,
 body.sidebar-compact .sidebar .nav-label,
 body.sidebar-compact .sidebar .sidebar-bottom{display:block}
 body.sidebar-compact .sidebar .nav-item{justify-content:flex-start;padding:13px 16px;gap:13px}
 body.sidebar-compact .sidebar .nav-item>span:first-child{width:22px;font-size:20px}
 .topbar{height:65px}
}
@media(max-width:650px){
 .topbar{padding:0 12px}
 .main-content{padding:16px 10px}
 .q-page-scroll img,.q-page-scroll img#qExamPage{min-width:0!important}
 .q-book{max-height:48dvh}
 .q-page-scroll{height:calc(48dvh - 56px);padding:3px}
 .q-page-toolbar{padding:8px;font-size:11px}
 .q-page-toolbar>div{gap:4px}
 .q-page-toolbar .btn{padding:6px 9px}
 .q-interactive{padding:11px}
 .q-number-grid{grid-template-columns:repeat(8,minmax(0,1fr));gap:4px}
 .q-number{min-width:0;font-size:10px}
 .pdf-doc-shell .flex-row{gap:6px}
 .pdf-doc-shell .btn{white-space:normal}
 .top-actions #installBtn{padding:6px 9px;font-size:10px}
 .breadcrumbs{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
}
@supports not (height: 100dvh){
 .q-book{max-height:calc(100vh - 24px)}
 .q-book:fullscreen,.q-book.eo-fullscreen,.pdf-doc-shell:fullscreen,.pdf-doc-shell.eo-fullscreen{height:100vh!important}
}

/* A legenda do menu não deve herdar largura e fonte dos ícones. */
.sidebar .nav-item .nav-label{font-size:12px;width:auto;flex:1;text-align:left;white-space:nowrap;line-height:1.25}
.pdf-doc-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
@media(max-width:950px){body.sidebar-compact .sidebar .nav-item .nav-label{display:inline;text-align:left}}

/* Leitor nítido: o PDF original é renderizado pelo navegador em resolução vetorial. */
.q-book .eo-pdf-stage{
  display:block!important; padding:0!important; width:100%; min-width:0;
  height: min(76dvh, 850px); max-height:none; overflow:hidden!important;
  background:#f1f3f7;
}
.q-book .eo-pdf-stage iframe#qExamPage{
  display:block; border:0; width:100%; height:100%; min-width:0; max-width:100%;
  background:white;
}
.q-page-toolbar a.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
.q-book:fullscreen .eo-pdf-stage, .q-book.eo-fullscreen .eo-pdf-stage{
  flex:1 1 auto;height:auto!important;max-height:none!important;min-height:0;
}
@media(max-width:1160px){.q-book .eo-pdf-stage{height: min(66dvh, 710px)}}
@media(max-width:650px){
 .q-book .eo-pdf-stage{height:55dvh;min-height:285px;}
 .q-page-toolbar{gap:6px}
 .q-page-toolbar>div{display:flex;gap:4px;flex-wrap:wrap}
 .q-page-toolbar .btn{font-size:11px;padding:6px 8px}
}

/* Atualização 2.5 — Cabeçalho fixo inclusive na tela Banco de provas. */
body.bank-page .topbar{position:sticky!important;top:0;z-index:40;box-shadow:0 2px 10px rgba(12,23,48,.06)!important}
/* Não cria uma segunda área de rolagem para o cartão de respostas. */
.q-layout.with-pages .q-interactive,.q-interactive,#quizCurrent,.q-number-grid{
  height:auto!important;max-height:none!important;overflow-y:visible!important;
}
.q-layout.with-pages .q-interactive{align-self:start;position:relative}
.q-interactive .q-number-grid{grid-template-columns:repeat(8,minmax(0,1fr));gap:4px}
.q-interactive .q-number{min-height:31px;padding:4px 1px}
.q-interactive .q-notes textarea{min-height:85px}
.q-interactive .q-notes{margin-top:12px}
/* Navegação direta dos cartões de disciplina para sua lista. */
.filter-bar{scroll-margin-top:100px}
.subject-tiles{scroll-margin-top:100px}
/* Calendário acessível e campo brasileiro. */
.eo-date-field{display:flex;align-items:center;position:relative;width:100%;gap:5px}
.eo-date-field .eo-date-text{flex:1;min-width:0}
.eo-date-trigger{flex:none;height:41px;min-width:42px;border-radius:10px;border:1px solid var(--border);background:var(--surface2);color:var(--text);font-size:19px}
.eo-date-trigger:hover{background:var(--violet-light);color:var(--violet)}
.eo-date-native{position:absolute;right:0;bottom:0;width:1px!important;height:1px!important;opacity:0;pointer-events:none;padding:0;border:0}
@media(max-width:650px){
  .q-interactive{overflow:visible!important}
  .q-number-grid{gap:3px}
  .q-number{font-size:11px;min-height:30px}
  .topbar{z-index:40}
}

/* 26/11/2026 — menu legível, visual limpo sem barra de rolagem à vista. */
.sidebar{scrollbar-width:none!important;-ms-overflow-style:none!important;}
.sidebar::-webkit-scrollbar{display:none!important;width:0!important;}
.sidebar .nav-item .nav-label{font-size:13.5px!important;line-height:1.3!important;letter-spacing:0!important;}
.sidebar .nav-item{min-height:43px;}
@media(min-width:951px) and (max-height:820px){
  .sidebar{padding-top:12px!important;padding-bottom:8px!important;}
  .sidebar .brand{padding-bottom:13px!important;}
  .sidebar .side-heading{margin-bottom:5px!important;}
  .sidebar .nav-item{min-height:38px;padding-top:7px!important;padding-bottom:7px!important;}
  .sidebar .sidebar-bottom{padding-top:6px!important;}
  .sidebar .side-exam{padding:10px!important;margin-bottom:6px!important;}
  .sidebar .side-footer{font-size:10px!important;}
}
/* Caderno dentro da página de respostas no celular, sem abrir nova tela. */
@media(max-width:700px){
 .q-layout.with-pages{display:flex!important;flex-direction:column;gap:10px;}
 .q-layout.with-pages>.q-book,.q-layout.with-pages>.q-interactive{width:100%;max-width:100%;}
 .q-layout.with-pages>.q-book{position:relative!important;top:auto!important;max-height:none!important;overflow:visible!important;z-index:auto!important;}
 .q-book .eo-pdf-stage{display:block!important;width:100%!important;height:50dvh!important;min-height:260px!important;max-height:540px!important;overflow:auto!important;overscroll-behavior:contain;background:#edf1f7;touch-action:pan-x pan-y;}
 .q-book .eo-pdf-stage img.eo-mobile-page,
 .q-book .eo-pdf-stage img#qExamPage{display:block!important;height:auto!important;max-width:none!important;max-height:none!important;min-width:0!important;object-fit:unset!important;margin:0!important;}
 .q-book .q-page-toolbar{position:relative;z-index:1;}
 .q-book:fullscreen .eo-pdf-stage,.q-book.eo-fullscreen .eo-pdf-stage{flex:1 1 auto;height:auto!important;max-height:none!important;min-height:0!important;}
}
