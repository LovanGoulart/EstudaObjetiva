/* Provas reais — leitura de PDF e cartão de respostas */
.real-intro{line-height:1.65;margin:0 0 17px;color:var(--muted)}
.real-catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.real-card{padding:19px;display:flex;flex-direction:column;gap:13px}
.real-card h3{font-size:17px}.real-meta{display:flex;gap:7px;flex-wrap:wrap}.real-meta span{padding:5px 9px;border-radius:8px;background:var(--surface2);color:var(--muted);font-size:11px;font-weight:700}
.real-card .real-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}
.real-test-layout{display:grid;grid-template-columns:minmax(300px,1.2fr) minmax(320px,.8fr);gap:14px;align-items:start}
.real-pdf{min-height:75vh;position:sticky;top:12px;overflow:hidden}.real-pdf iframe{height:76vh;display:block;width:100%;border:0;background:white}
.real-side{padding:19px}.real-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.real-answer-grid{display:grid;gap:12px}.real-question{padding:11px 12px;border-radius:11px;background:var(--surface2);border:1px solid var(--border)}
.real-question-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:8px;font-size:12px;font-weight:750}
.real-options{display:flex;gap:5px;flex-wrap:wrap}.real-options label{position:relative;display:flex;align-items:center;justify-content:center;width:37px;height:37px;cursor:pointer;border:1px solid var(--border);border-radius:9px;background:var(--surface);font-weight:750}
.real-options input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}.real-options label:has(input:checked){background:var(--violet);border-color:var(--violet);color:#fff}.real-options label:focus-within{outline:2px solid var(--teal)}
.real-question.is-ok{border-color:#24a88a}.real-question.is-wrong{border-color:#db7b7b}.real-question.is-null{border-color:#a19ba8}
.real-result{font-size:12px;margin-top:7px;line-height:1.6}.real-review-list{display:grid;gap:9px}.real-sticky-actions{position:sticky;bottom:0;padding:14px;background:var(--surface);border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;align-items:center}
@media(max-width:1150px){.real-test-layout{grid-template-columns:1fr}.real-pdf{position:static;min-height:0}.real-pdf iframe{height:55vh}}@media(max-width:650px){.real-catalog{grid-template-columns:1fr}.real-pdf iframe{height:50vh}.real-side{padding:12px}.real-options label{width:35px;height:35px}}

/* Correção do menu lateral: o cartão da prova e o rodapé não podem escapar do fundo. */
.sidebar{
  height:100vh;
  height:100dvh;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior-y:contain;
  scrollbar-width:thin;
  scrollbar-color:#354767 transparent;
}
.sidebar .brand,.sidebar .side-heading,.sidebar #nav,.sidebar .sidebar-bottom{
  flex-shrink:0;
}
.sidebar .sidebar-bottom{
  width:100%;
  padding-top:16px;
}
.sidebar .side-exam{
  margin-bottom:12px;
}
.sidebar .side-footer{
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
  line-height:1.5;
}
@media(max-height:850px){
  .sidebar{padding-top:18px;padding-bottom:14px;}
  .sidebar .brand{padding-bottom:18px;}
  .sidebar .side-heading{margin-bottom:7px;}
  .sidebar .nav-item{padding-top:10px;padding-bottom:10px;}
  .sidebar .sidebar-bottom{padding-top:10px;}
  .sidebar .side-exam{padding:14px;margin-bottom:10px;}
}
@media(max-height:650px){
  .sidebar .brand{padding-bottom:12px;}
  .sidebar .nav-item{padding-top:8px;padding-bottom:8px;}
}

/* EstudaObjetiva 2.0 — prova interativa, aulas e biblioteca */
.bank-note{font-size:13px;line-height:1.65;color:var(--muted);background:var(--surface);border:1px solid var(--border);padding:14px 16px;border-radius:14px;margin-bottom:17px}
.bank-note strong{color:var(--text)}
.q-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(350px,0.95fr);gap:16px;align-items:start}
.q-layout.native-only{grid-template-columns:1fr;max-width:950px}
.q-book{position:sticky;top:12px;overflow:hidden}
.q-page-toolbar{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;gap:8px;font-size:12px;border-bottom:1px solid var(--border)}
.q-page-toolbar>div{display:flex;gap:5px}
.q-page-scroll{overflow:auto;max-height:73vh;background:#f0f3f7;text-align:center}
.q-page-scroll img{display:block;width:100%;height:auto;min-width:600px;max-width:100%;margin:auto}
.q-book-help{padding:10px 14px;font-size:11px;line-height:1.5;color:var(--muted)}
.q-interactive{padding:17px;min-width:0}
.q-question-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.q-number-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:17px}
.q-number{border-radius:7px;min-height:33px;background:var(--surface2);color:var(--text);border:1px solid var(--border);font-size:11px;font-weight:750;cursor:pointer}
.q-number.selected{background:var(--violet);color:white;border-color:var(--violet)}
.q-number.answered:not(.selected){border-color:#16ae9e;color:var(--text);background:#20bca01b}
.q-number.r-acerto:not(.selected){background:#169a7022;border-color:#169a70;color:var(--text)}
.q-number.r-erro:not(.selected){background:#e15b5620;border-color:#d95f55}
.q-number.r-anulada:not(.selected){background:#a7a7bb22}
.q-label{color:var(--violet);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px}
.q-body h2{font-size:17px;line-height:1.65;margin:13px 0 17px;font-weight:700;white-space:pre-wrap}
.q-context{margin:16px 0;padding:14px;border-radius:12px;background:var(--surface2);font-size:12px;line-height:1.7}
.q-context p{margin-top:7px}
.q-option-list{display:grid;gap:10px;margin-bottom:12px}
.q-full-option{display:flex;align-items:start;gap:10px;padding:13px;border:1px solid var(--border);border-radius:11px;cursor:pointer;font-size:13px;line-height:1.6;transition:all .12s}
.q-full-option:has(input:checked){border-color:var(--violet);background:var(--violet-light)}
.q-full-option.is-correct{border-color:#20a584}
.q-full-option input{accent-color:var(--violet);margin-top:6px}
.q-full-option .letter{display:flex;align-items:center;justify-content:center;flex:none;font-size:11px;font-weight:800;width:26px;height:26px;background:var(--surface2);border-radius:7px}
.q-choice-field{border:0;padding:0;margin:17px 0}
.q-choice-field legend{font-size:12px;font-weight:750;margin-bottom:8px}
.q-choices{display:flex;gap:7px;flex-wrap:wrap}
.q-choice{border-radius:10px;border:1px solid var(--border);cursor:pointer;min-width:45px;min-height:46px;display:grid;place-items:center;position:relative;font-weight:800;background:var(--surface)}
.q-choice input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.q-choice.chosen{background:var(--violet);border-color:var(--violet);color:white}
.q-choice.correct{border-color:#27af8b}
.q-answer-result{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px;border-radius:10px;font-size:12px;margin-top:12px;background:var(--surface2);line-height:1.5}
.q-answer-result.acerto{background:#139b8220;border:1px solid #159b8266}
.q-answer-result.erro{background:#e05d5d17;border:1px solid #c9595944}
.q-answer-result span{display:block}
.q-explain{padding:14px;background:var(--surface2);border-radius:10px;margin-top:12px;font-size:12px;line-height:1.7}
